# ASAPA desktop AI mentor settings.
# Copy this file to  %LOCALAPPDATA%\IndustrialAcademy\config.env  (created
# automatically on first launch as a template) and fill in a provider + key to
# enable the live LLM mentor over the internet. The app always works offline
# with the built-in Socratic engine when these are absent, and falls back to it
# automatically if the provider is unreachable.
#
#   AI_PROVIDER=openrouter            # openai | openrouter | anthropic | gemini | ollama
#   AI_API_KEY=sk-or-...              # your key for the chosen provider
#   AI_BASE_URL=                      # optional custom OpenAI-compatible endpoint
#   AI_MODEL=                         # optional model override (provider default when blank)
#
# Environment variables set on the machine take precedence over this file.
# The backend defaults by provider (when AI_MODEL is blank):
#   openai -> gpt-4o-mini, openrouter -> openai/gpt-4o-mini,
#   anthropic -> claude-3-5-sonnet-latest, gemini -> gemini-2.0-flash,
#   ollama -> llama3.2 (http://127.0.0.1:11434/v1)