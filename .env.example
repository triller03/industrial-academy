# ----------------------------------------------
# ASAPA (Industrial Automation Training Platform) - configuration
# ----------------------------------------------
# Copy to ./.env for local runs, or use docker compose which reads this file.
# docker compose treats ENVIRONMENT=production automatically (see compose file).

# --- runtime -----------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
# Seed demo accounts (demo@academy.local, admin@academy.local) on an empty DB.
# Leave 0 on an internet-facing instance unless you want well-known passwords.
SEED_ON_STARTUP=1
# Public origin used for shareable portfolio links, e.g. https://asapa.onrender.com
INTERFACE_ORIGIN=

# --- database ----------------------------------------------------------
# docker compose overrides this with sqlite:////app/data/academy.db
DATABASE_URL=sqlite:///./academy.db

# --- network -----------------------------------------------------------
# Comma-separated list of allowed browser origins. Mirror your frontend URL.
CORS_ORIGINS=*
# Set 1 and terminate TLS in your reverse proxy before facing the internet.
REQUIRE_HTTPS=0

# --- abuse protection --------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=60
RATE_LIMIT_GLOBAL_PER_MINUTE=600
DEVICE_LIMIT_PER_USER=3
MAX_DAYS_OFFLINE_SYNC=90

# --- integrations ------------------------------------------------------
INTEGRATIONS_ENABLED=1
SIMULATED_PLANT=1
MODBUS_ENABLED=1
MODBUS_HOST=127.0.0.1
# Use a port >=1024 in containers: the Dockerfile runs as a non-root user.
MODBUS_PORT=1502
S7_ENABLED=0
S7_IP=192.168.0.1
S7_RACK=0
S7_SLOT=1
S7_DB=1
OPCUA_ENABLED=0
OPCUA_URL=opc.tcp://127.0.0.1:4840
OPCUA_NODES=

# --- generate a real secret with ---------------------------------------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the resulting .env file.