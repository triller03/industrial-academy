# ASAPA backend configuration (example). Copy to backend/.env and adjust.
# All values below are the built-in defaults; uncomment/edit only what you need.

# ---------------------------------------------------------------------------
# Runtime mode
#   development: permissive CORS (*), no HTTPS check, demo seeding on.
#   production:  startup guard, HTTPS enforcement, restricted CORS defaults.
# ---------------------------------------------------------------------------
# ENVIRONMENT=development

# SQLite (default) -- path relative to the process working directory (backend/):
# DATABASE_URL=sqlite:///./academy.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://asapa:CHANGE-ME@localhost:5432/asapa

# 32+ char random secret. REQUIRED in production (starts the app). Never reuse a
# value that is public. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=change-me-in-production

# Access token lifetime (minutes). Default 1440 (24h).
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Network hardening
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. "*" allows all (development only).
# CORS_ORIGINS=https://asapa.app,https://app.asapa.app
# Require HTTPS for all requests behind the reverse proxy.
# REQUIRE_HTTPS=false
# Comma-separated CIDRs whose X-Forwarded-For is honoured.
# TRUSTED_PROXIES=10.0.0.0/8

# Sliding-window abuse protection (per client IP).
# RATE_LIMIT_AUTH_PER_MINUTE=60
# RATE_LIMIT_GLOBAL_PER_MINUTE=600

# ---------------------------------------------------------------------------
# Licensing & tiered plans (blueprint)
# ---------------------------------------------------------------------------
# Days a fresh user stays on a full-access trial before down-sell gating.
# TRIAL_GRACE_DAYS=30
# Sandbox free-tier cap on online fault diagnoses per day.
# MAX_FREE_FAULT_ATTEMPTS_PER_DAY=5
# Issued license validity once activated (Stripe/Paynow/test gateway).
# LICENSE_LENGTH_DAYS=365
# Registered devices per user (HWID binding limit).
# DEVICE_LIMIT_PER_USER=3
# Public origin used to build shareable portfolio URLs.
# INTERFACE_ORIGIN=

# ---------------------------------------------------------------------------
# Billing gateways. Empty = local test checkout gateway (paid plans activate
# instantly through /api/billing/test-checkout with the order id).
# ---------------------------------------------------------------------------
# Stripe:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MAP={"student_pro":"price_1ABC","professional":"price_2DEF","institutional":"price_3GHI"}
# Paynow (Zimbabwe):
# PAYNOW_INTEGRATION_ID=
# PAYNOW_API_KEY=
# PAYNOW_RESULT_URL=https://asapa.app/api/billing/webhook

# ---------------------------------------------------------------------------
# TIA Openness bridge (blueprint, hardware dependent)
# pypywin32 + a licensed Siemens TIA Openness host on tia_openness_host.
# When disabled (default) the probe reports not-available and the SCL/CSV
# pre-compile validators run rule-based and offline.
# ---------------------------------------------------------------------------
# TIA_OPENNESS_ENABLED=false
# TIA_OPENNESS_HOST=127.0.0.1
# TIA_OPENNESS_PORT=8600

# ---------------------------------------------------------------------------
# AI Mentor LLM backend.
# Empty provider = deterministic Socratic engine (offline, no keys, no cost;
# still answers but without true LLM reasoning).
# Providers: openai | openrouter | anthropic | gemini | ollama
# Any OpenAI-compatible endpoint (Ollama, vLLM, Groq, DeepSeek, LM Studio…) can
# also be targeted by setting AI_PROVIDER=openai with AI_BASE_URL + your key.
# ---------------------------------------------------------------------------
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=            # default per provider; e.g. http://127.0.0.1:11434/v1 for Ollama
# AI_MODEL=               # provider default used when blank (e.g. gpt-4o-mini, claude-3-5-sonnet-latest, gemini-2.0-flash)
# AI_MAX_TOKENS=900
# AI_TIMEOUT_SECONDS=60
# AI_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# Integration layer (FACTORY I/O / TIA Portal / WinCC)
# ---------------------------------------------------------------------------
# INTEGRATIONS_ENABLED=true
# SIMULATED_PLANT=true
# MODBUS_ENABLED=true
# MODBUS_HOST=127.0.0.1
# MODBUS_PORT=502
# S7_ENABLED=false
# S7_IP=192.168.0.1
# S7_RACK=0
# S7_SLOT=1
# S7_DB=1
# OPCUA_ENABLED=false
# OPCUA_URL=opc.tcp://127.0.0.1:4840
# OPCUA_NODES=

# Seed demo + admin learners and the curriculum on startup (idempotent).
# SEED_ON_STARTUP=true